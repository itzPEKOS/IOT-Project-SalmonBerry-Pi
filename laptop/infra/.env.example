# คัดลอกเป็น .env ด้วย: python make_env.py   (ห้าม commit ไฟล์ .env)

# ใช้ broker ชั่วคราวบน laptop; ถ้าใช้ broker บน Pi ให้ลบบรรทัดนี้ แล้วตั้ง MQTT_URL
COMPOSE_PROFILES=devbroker
MQTT_URL=tcp://mosquitto:1883
MQTT_USER=rlgl
MQTT_PASSWORD=CHANGE_ME

INFLUX_ORG=rlgl
INFLUX_BUCKET=rlgl
INFLUX_USER=rlgl-admin
INFLUX_PASSWORD=CHANGE_ME
INFLUX_TOKEN=CHANGE_ME

GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME

# 127.0.0.1 = เปิดได้เฉพาะเครื่องนี้
# เปลี่ยนเป็น 0.0.0.0 เมื่อต้องให้ ESP32 หรือเครื่องอื่นในวงต่อเข้ามา (ใช้เฉพาะเครือข่ายของกลุ่ม)
BIND_IP=127.0.0.1
