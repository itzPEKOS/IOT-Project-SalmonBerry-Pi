{
  "uid": "rlgl-main",
  "title": "Red Light / Green Light",
  "timezone": "browser",
  "schemaVersion": 40,
  "refresh": "1s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1s",
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "สด: เกมและผู้เล่น",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "stat",
      "title": "สถานะเกม",
      "datasource": {
        "type": "influxdb",
        "uid": "rlgl-influx"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "rlgl-influx"
          },
          "query": "from(bucket: \"rlgl\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"game_state\" and (r._field == \"state\"))\n  |> group()\n  |> sort(columns: [\"_time\"])\n  |> last()\n  |> keep(columns: [\"_value\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "noValue": "--",
          "mappings": [
            {
              "type": "value",
              "options": {
                "IDLE": {
                  "color": "#808080",
                  "text": "IDLE"
                },
                "CALIBRATE": {
                  "color": "#808080",
                  "text": "CALIBRATE"
                },
                "GREEN_LIGHT": {
                  "color": "green",
                  "text": "GREEN_LIGHT"
                },
                "TRANSITION": {
                  "color": "red",
                  "text": "TRANSITION"
                },
                "RED_LIGHT": {
                  "color": "red",
                  "text": "RED_LIGHT"
                },
                "GAME_OVER": {
                  "color": "dark-red",
                  "text": "GAME_OVER"
                },
                "WIN": {
                  "color": "blue",
                  "text": "WIN"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
